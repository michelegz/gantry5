{% extends '@nucleus/partials/particle.html.twig' %}

{% set attr_extra = particle.extra|attribute_array %}
{% set article_settings = particle.article %}
{% set filter = article_settings.filter %}
{% set sort = article_settings.sort %}
{% set limit = article_settings.limit %}
{% set display = article_settings.display %}

{# Category Finder #}
{% set category_options = filter.categories ? {id: [filter.categories|split(','), 0]} : {} %}
{% set categories = joomla.finder('category', category_options).published(1).language().limit(0).find() %}

{# Content Finder #}
{% if filter.articles %}
    {% set article_options = filter.articles ? {id: [filter.articles|replace({' ': ''})|split(',')]} : {} %}
    {% set article_finder = joomla.finder('content', article_options).published(1).language() %}
{% else %}
    {% set article_finder = joomla.finder('content').category(categories).published(1).language() %}
    {# Tags - now supports both IDs and names #}
    {% if filter.tags %}
        {% set tags_options = {id: [filter.tags|replace(' ', '')]} %}
        {% do article_finder.tags(tags_options) %}
    {% endif %}
{% endif %}

{% set featured = filter.featured|default('include') %}
{% if featured == 'exclude' %}
    {% do article_finder.featured(false) %}
{% elseif featured == 'only' %}
    {% do article_finder.featured(true) %}
{% endif %}

{# Recent-days filter on publish_up (configurable X). Uses the already public where() on Finder.
   Skipped when specific article IDs are selected: only those are shown in that case. #}
{% set recent_days = filter.recent_days|default(0)|int %}
{# Legacy: 'hits_recent' removed from UI options, still mapped to hits for saved configs. #}
{% set is_hits_recent = sort.orderby == 'hits_recent' %}
{# Generic ranking delegated to listening plugins via the onContentRankIds event. #}
{% set is_ranking = sort.orderby == 'ranking' %}
{% set has_explicit_articles = filter.articles|default('')|trim != '' %}
{% if (recent_days > 0 or is_hits_recent) and not has_explicit_articles %}
    {% set days = recent_days > 0 ? recent_days : 30 %}
    {# DB publish_up is UTC: build the cutoff in UTC, otherwise the site offset
       (e.g. Europe/Rome +2h) shifts the window. #}
    {% set cutoff = ("now"|date_modify("-" ~ days ~ " days"))|date("Y-m-d H:i:s", "UTC") %}
    {% do article_finder.where('a.publish_up', '>=', cutoff) %}
{% endif %}

{# Pagination mode: '' = hide, 'pagination' = Prev/Next (replace), 'loadmore' = append.
   'show' is the legacy value and is treated as 'pagination' for backward compatibility.
   Defined first: everything below (exclusion parsing, query_start, limits) depends on it. #}
{% set raw_pagination = display.pagination_buttons|default('') %}
{% set pagination_mode = raw_pagination == 'show' ? 'pagination' : raw_pagination %}
{% set is_pagination = pagination_mode == 'pagination' %}
{% set is_loadmore = pagination_mode == 'loadmore' %}

{# Cumulative offset: configured start plus the AJAX offset forwarded by Prev/Next/Load More.
   Defined before query_start so AJAX batches actually advance instead of re-reading page 0. #}
{% set start = limit.start|default(0)|int + max(0, ajax.start|default(0)|int) %}

{# Load More step: how many articles to append per click. Falls back to limit.total. #}
{% set load_more_step = article_settings.limit.load_more_step|default(limit.total)|int %}
{% if load_more_step < 1 %}
    {% set load_more_step = limit.total|int|default(2) %}
{% endif %}
{% set load_more_label = display.load_more.label|default('Load More') %}
{% set load_more_loading = display.load_more.loading_label|default('Loading...') %}
{% set load_more_archive_label = display.load_more.archive_label|default('')|trim %}
{% set load_more_archive_url = display.load_more.archive_url|default('')|trim %}
{% set has_end = load_more_archive_label and load_more_archive_url %}

{# Effective limit: first render uses limit.total, Load More calls pass ajax.limit = step.
   Prev/Next keep using limit.total (no ajax.limit). #}
{% set effective_limit = max(1, ajax.limit|default(limit.total)|int) %}
{% set load_more_max = article_settings.limit.load_more_max|default(0)|int %}
{# Max cap for Load More only: includes the initial ones too. 0 = no cap. #}
{% if is_loadmore and load_more_max > 0 %}
    {% set remaining = load_more_max - start %}
    {% if remaining <= 0 %}
        {% set effective_limit = 0 %}
    {% elseif effective_limit > remaining %}
        {% set effective_limit = remaining %}
    {% endif %}
{% endif %}

{# Exclude articles already shown by contentarray particles rendered earlier on the same page.
   First rendered wins (layout order). Skipped with explicit article IDs and on AJAX reloads. #}
{% set is_ajax_reload = ajax.start|default('') != '' or ajax.limit|default('') != '' %}
{% set exclude_shown = filter.exclude_shown|default('') == 'show' and not has_explicit_articles and not is_ajax_reload %}
{% if exclude_shown %}
    {% set seen_ids = joomla.contentarraySeen() %}
    {% if seen_ids is not empty %}
        {% do article_finder.where('a.id', 'NOT IN', seen_ids) %}
    {% endif %}
{% endif %}

{# Load More exclusion: AJAX calls forward the IDs already rendered on the page
   (see data-exclude-shown on the button) so appended batches never repeat them.
   Prev/Next keeps offset paging and is intentionally untouched. The list is
   bounded for URL safety and sanitized to positive ints; explicit article IDs
   opt out, same as the initial render. #}
{% set excluded_ids = [] %}
{% set raw_shown = ajax.shown|default('') %}
{% if is_loadmore and not has_explicit_articles and raw_shown is not iterable and raw_shown|trim != '' %}
    {% for raw_shown_id in raw_shown|split(',')|slice(0, 2000) %}
        {% set clean_shown_id = raw_shown_id|trim|int %}
        {% if clean_shown_id > 0 %}
            {% set excluded_ids = excluded_ids|merge([clean_shown_id]) %}
        {% endif %}
    {% endfor %}
{% endif %}
{% if excluded_ids is not empty %}
    {% do article_finder.where('a.id', 'NOT IN', excluded_ids) %}
{% endif %}
{# With an exclusion list the query pages by exclusion (offset 0): start-based
   offsets would double-skip. `start` is still the cumulative counter used for
   the load-more max cap and has_more math below. #}
{% set exclusion_active = excluded_ids is not empty %}
{% set query_start = exclusion_active ? 0 : start %}

{# Exclude the article currently being viewed (article view only, 0 elsewhere).
   On AJAX reloads there is no article context, so the ID is forwarded by the buttons. #}
{% set current_id = ajax.current|default(0)|int %}
{% if current_id <= 0 %}
    {% set current_id = joomla.currentArticleId()|default(0)|int %}
{% endif %}
{% if filter.exclude_current|default('') == 'show' and current_id > 0 %}
    {% do article_finder.where('a.id', 'NOT IN', [current_id]) %}
{% endif %}
{% if not is_ranking %}
{% if is_hits_recent %}
    {% do article_finder.order('hits', sort.ordering|default('DESC')).limit(max(1, effective_limit)).start(query_start) %}
{% else %}
    {% do article_finder.order(sort.orderby|default('publish_up'), sort.ordering|default('DESC')).limit(max(1, effective_limit)).start(query_start) %}
{% endif %}
{% endif %}
{% set total = article_finder.count() %}
{% if is_loadmore and load_more_max > 0 and total > load_more_max %}
    {% set total = load_more_max %}
{% endif %}
{% if effective_limit <= 0 %}
    {% set articles = [] %}
{% elseif is_ranking %}
    {% set articles = article_finder.findRanked(effective_limit, query_start, sort.ordering|default('DESC')) %}
{% else %}
    {% set articles = article_finder.find() %}
{% endif %}
{# Register rendered IDs so later contentarray particles can exclude them.
   Always marked, even when this instance does not exclude or uses explicit IDs.
   Named rendered_ids (not excluded_ids) so the exclusion list above is preserved
   for the has_more check below. #}
{% if articles is not empty %}
    {% set rendered_ids = [] %}
    {% for shown_article in articles %}
        {% set rendered_ids = rendered_ids|merge([shown_article.id]) %}
    {% endfor %}
    {% do joomla.contentarrayMark(rendered_ids) %}
{% endif %}
{# has_more: offset paging compares against the window end; exclusion paging
   (shown list) compares the remaining pool against the batch size, capped by
   load_more_max when set. #}
{% if exclusion_active %}
    {% set has_more = total > effective_limit and (load_more_max <= 0 or (start + effective_limit) < load_more_max) %}
{% else %}
    {% set has_more = (start + effective_limit) < total %}
{% endif %}

{# Ordering positions (1-5), fallback to original order for backward compatibility #}
{% set order_image = display.ordering.image|default(1)|int %}
{% set order_title = display.ordering.title|default(2)|int %}
{% set order_details = display.ordering.details|default(3)|int %}
{% set order_text = display.ordering.text|default(4)|int %}
{% set order_readmore = display.ordering.readmore|default(5)|int %}
{% set title_overlay = display.title.overlay == 'show' and display.image.enabled and display.title.enabled %}

{% block particle %}

     {% if particle.title %}
            <h2 class="g-title">{{ particle.title|raw }}</h2>
        {% endif %}

    {# All Articles #}
    <div class="g-content-array g-joomla-articles{% if particle.css.class %} {{ particle.css.class }}{% endif %}{% if title_overlay %} g-title-overlay-enabled{% endif %}" {{- attr_extra|raw }}>

        <div class="g-content-array-items">
        {% for column in articles|batch(limit.columns) %}
            <div class="g-grid">
                {% for article in column %}

                    <div class="g-block">
                        <div class="g-content">
                            <div class="g-array-item" data-article-id="{{ article.id }}">
                                {% if display.edit and article.edit %}
                                    {% if not joomla.checkVersion('4.0') %}
                                        <a class="g-array-item-edit" href="{{ article.edit }}">{{ 'COM_CONTENT_FORM_EDIT_ARTICLE'|trans }}</a>
                                    {% else %}
                                        <a class="g-array-item-edit" href="{{ article.edit }}" aria-describedby="editarticle-{{ article.id }}">{{ 'JGLOBAL_EDIT'|trans }}</a>
                                    {% endif %}
                                {% endif %}

                                {# Resolve image once per article, reused for both <img> and background overlay #}
                                {% set article_image = null %}
                                {% set article_image_alt = '' %}
                                {% if article.images.image_intro and display.image.enabled in ['intro', 'show'] %}
                                    {% set article_image = article.images.image_intro %}
                                    {% set article_image_alt = article.images.image_intro_alt %}
                                {% elseif article.images.image_fulltext and display.image.enabled == 'full' %}
                                    {% set article_image = article.images.image_fulltext %}
                                    {% set article_image_alt = article.images.image_fulltext_alt %}
                                {% endif %}
                                {% set use_overlay = title_overlay and article_image %}

                                {% for pos in 1..5 %}
                                    {# IMAGE or IMAGE+TITLE OVERLAY #}
                                    {% if order_image == pos and display.image.enabled and article_image %}
                                                              {% if use_overlay %}
                                                                  <div class="g-array-item-image-title g-array-item-image-title-overlay" style="background-image: url('{{ url(article_image) }}');" role="img" aria-label="{{ article_image_alt|default(article.title)|e }}">
                                                                      <a href="{{ article.route }}" class="g-array-item-image-title-link" aria-label="{{ (display.title.limit ? article.title|truncate_text(display.title.limit) : article.title)|e }}">
                                                                          <div class="g-array-item-image-title-overlay-bg"></div>
                                                                          <div class="g-array-item-title">
                                                                              <h3 class="g-item-title">
                                                                                  {{ display.title.limit ? article.title|truncate_text(display.title.limit) : article.title }}
                                                                              </h3>
                                                                          </div>
                                                                      </a>
                                                                  </div>
                                        {% else %}
                                            <div class="g-array-item-image">
                                                <a href="{{ article.route }}">
                                                    <img src="{{ url(article_image) }}" {{ article_image|imagesize|raw }} alt="{{ article_image_alt }}" />
                                                </a>
                                            </div>
                                        {% endif %}
                                    {% endif %}

                                    {# Standalone TITLE (skipped when overlay is active and an image is present) #}
                                    {% if order_title == pos and display.title.enabled and not use_overlay %}
                                        <div class="g-array-item-title">
                                            <h3 class="g-item-title">
                                                <a href="{{ article.route }}">
                                                    {{ display.title.limit ? article.title|truncate_text(display.title.limit) : article.title }}
                                                </a>
                                            </h3>
                                        </div>
                                    {% endif %}

                                    {# DETAILS #}
                                    {% if order_details == pos and (display.date.enabled or display.author.enabled or display.category.enabled or display.hits.enabled) %}
                                        <div class="g-array-item-details">
                                            {% if display.date.enabled %}
                                                <span class="g-array-item-date">
                                                    {% if display.date.enabled == 'published' %}
                                                        <i class="far fa-clock" aria-hidden="true"></i>{{ article.publish_up|date(display.date.format) }}
                                                    {% elseif display.date.enabled == 'modified' %}
                                                        <i class="far fa-clock" aria-hidden="true"></i>{{ article.modified|date(display.date.format) }}
                                                    {% else %}
                                                        <i class="far fa-clock" aria-hidden="true"></i>{{ article.created|date(display.date.format) }}
                                                    {% endif %}
                                                </span>
                                            {% endif %}

                                            {% if display.author.enabled %}
                                                <span class="g-array-item-author">
                                                    <i class="fa fa-user" aria-hidden="true"></i>{{ article.author.name }}
                                                </span>
                                            {% endif %}

                                            {% if display.category.enabled %}
                                                {% set category_link = display.category.enabled == 'link' %}
                                                <span class="g-array-item-category">
                                                    {% set cat = article.categories|last %}
                                                    {% if category_link %}
                                                        <a href="{{ cat.route }}">
                                                            <i class="fa fa-folder-open" aria-hidden="true"></i>{{ cat.title }}
                                                        </a>
                                                    {% else %}
                                                        <i class="fa fa-folder-open" aria-hidden="true"></i>{{ cat.title }}
                                                    {% endif %}
                                                </span>
                                            {% endif %}

                                            {% if display.hits.enabled %}
                                                <span class="g-array-item-hits">
                                                    <i class="fa fa-eye" aria-hidden="true"></i>{{ article.hits }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                    {# TEXT #}
                                    {% if order_text == pos and display.text.type %}
                                        {% set article_text = display.text.type == 'intro' ? display.text.prepare ? article.preparedIntroText : article.introtext : display.text.prepare ? article.preparedText : article.text %}
                                        <div class="g-array-item-text">
                                            {% if display.text.formatting == 'text' %}
                                                {{ article_text|truncate_text(display.text.limit)|raw }}
                                            {% else %}
                                                {{ article_text|truncate_html(display.text.limit)|raw }}
                                            {% endif %}
                                        </div>
                                    {% endif %}

                                    {# READ MORE #}
                                    {% if order_readmore == pos and display.read_more.enabled %}
                                        <div class="g-array-item-read-more">
                                            <a href="{{ article.route }}" class="button{% if display.read_more.css %} {{ display.read_more.css }}{% endif %}">
                                                {{ display.read_more.label|default('Read More...') }}
                                            </a>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                {% endfor %}
            </div>
        {% endfor %}
        </div>

        {% if is_pagination and total > limit.total %}
            <div class="g-content-array-pagination">
                <button class="button float-left contentarray-button pagination-button pagination-button-prev" data-id="{{ id }}" data-start="{{ max(0, start - limit.total|int|default(2)) }}" data-current="{{ current_id }}"{{ start - limit.total|int|default(2) < 0 ? ' disabled' }}>{{ 'GANTRY5_ENGINE_PREV'|trans }}</button>
                <button class="button float-right contentarray-button pagination-button pagination-button-next" data-id="{{ id }}" data-start="{{ start + limit.total|int|default(2) }}" data-current="{{ current_id }}"{{ start + limit.total|int|default(2) >= total ? ' disabled' }}>{{ 'GANTRY5_ENGINE_NEXT'|trans }}</button>
                <div class="clearfix"></div>
            </div>
        {% endif %}

        {% if is_loadmore and (has_more or has_end) %}
            <div class="g-content-array-loadmore">
                {% if has_more %}
                <button class="button contentarray-loadmore-button" data-id="{{ id }}" data-next="{{ (start - (limit.start|default(0)|int) + effective_limit) }}" data-step="{{ load_more_step }}" data-total="{{ total }}" data-current="{{ current_id }}" data-loading="{{ load_more_loading|e }}" data-exclude-shown="{{ (filter.exclude_shown|default('') == 'show' and not has_explicit_articles) ? '1' : '0' }}">{{ load_more_label }}</button>
                {% endif %}
                {% if has_end %}
                <div class="g-content-array-loadmore-end"{% if has_more %} style="display:none;"{% endif %}>
                    {% if load_more_archive_label and load_more_archive_url %}
                    <a class="button contentarray-archive-button" href="{{ load_more_archive_url|e }}">{{ load_more_archive_label }}</a>
                    {% endif %}
                </div>
                {% endif %}
                <div class="clearfix"></div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascript_footer %}
{% if is_pagination and total > limit.total %}
{% do gantry.load('jquery') %}
<script>
    (function ($) {
        $(document).on('click', 'button.contentarray-button', function () {
            var id = $(this).attr('data-id'),
                start = $(this).attr('data-start'),
                current = $(this).attr('data-current') || 0,
                request = {
                'option' : 'com_ajax',
                'plugin' : 'particle',
                'Itemid' : {{ gantry.page.itemid|int }},
                'id'     : id,
                'start'  : start,
                'current': current,
                'format' : 'json'
            };
            $.ajax({
                type       : 'GET',
                data       : request,
                indexValue : id + '-particle',
                success: function (response) {
                    if(response.data){
                        $('#' + this.indexValue).html(response.data[0].html);
                    } else {
                        // TODO: Improve error handling -- instead of replacing particle content, display flash message or something...
                        $('#' + this.indexValue).html(response.message);
                    }
                },
                error: function(response) {
                    // TODO: Improve error handling -- instead of replacing particle content, display flash message or something...
                    $('#' + this.indexValue).html('AJAX FAILED ON ERROR');
                }
            });
            return false;
        });
    })(jQuery)
</script>
{% endif %}
{% if is_loadmore and total > limit.total %}
{% do gantry.load('jquery') %}
<script>
    (function ($) {
        $(document).on('click', 'button.contentarray-loadmore-button', function () {
            var $btn = $(this),
                $scope = $btn.closest('.g-content-array'),
                $items = $scope.find('.g-content-array-items'),
                $end = $scope.find('.g-content-array-loadmore-end'),
                id = $btn.attr('data-id'),
                next = parseInt($btn.attr('data-next'), 10) || 0,
                step = parseInt($btn.attr('data-step'), 10) || 1,
                total = parseInt($btn.attr('data-total'), 10) || 0,
                current = $btn.attr('data-current') || 0,
                excludeShown = $btn.attr('data-exclude-shown') === '1',
                originalLabel = $btn.text(),
                loadingLabel = $btn.attr('data-loading') || 'Loading...',
                request = {
                    'option' : 'com_ajax',
                    'plugin' : 'particle',
                    'Itemid' : {{ gantry.page.itemid|int }},
                    'id'     : id,
                    'start'  : next,
                    'limit'  : step,
                    'current': current,
                    'format' : 'json'
                };
            if (excludeShown) {
                // Collect rendered IDs from ALL contentarray particles on the page,
                // not just this one: on the initial render exclude_shown covers
                // every particle rendered before (via contentarraySeen), but an
                // AJAX request is a fresh request with an empty Seen registry,
                // so the client must forward the global list. Scoping to
                // $scope here would let articles shown by other particles
                // reappear in appended batches.
                var seenIds = {};
                $(document).find('.g-content-array .g-array-item[data-article-id]').each(function () {
                    var aid = parseInt($(this).attr('data-article-id'), 10) || 0;
                    if (aid > 0) {
                        seenIds[aid] = true;
                    }
                });
                // Bounded for URL safety, mirrors the server-side slice(0, 2000).
                var shown = Object.keys(seenIds).slice(0, 2000).join(',');
                if (shown) {
                    request.shown = shown;
                }
            }
            var exclusionActive = excludeShown && !!request.shown;
            if ($btn.prop('disabled')) {
                return false;
            }
            $btn.prop('disabled', true).text(loadingLabel);
            $.ajax({
                type : 'GET',
                data : request,
                success: function (response) {
                    var html = response && response.data ? response.data[0].html : null;
                    if (!html) {
                        $btn.prop('disabled', false).text(originalLabel);
                        return;
                    }
                    var $parsed = $('<div>').html(html),
                        $grids = $parsed.find('.g-grid');
                    if (!$grids.length) {
                        $grids = $parsed.find('.g-content-array-items').children();
                    }
                    var count = $grids.find('.g-array-item').length;
                    if (!count) {
                        count = $grids.filter('.g-array-item').length;
                        if (count) {
                            $items.append($grids);
                        }
                    } else {
                        $items.append($grids);
                    }
                    if (!count) {
                        $btn.hide();
                        $end.show();
                        return;
                    }
                    next += count;
                    $btn.attr('data-next', next);
                    if (exclusionActive) {
                        // Exclusion paging: the server returns from the remaining
                        // pool, so a short batch means the pool is drained. The
                        // shrinking server total must not hide the button early.
                        if (count < step) {
                            $btn.hide();
                            $end.show();
                        } else {
                            $btn.prop('disabled', false).text(originalLabel);
                        }
                    } else if (next >= total) {
                        $btn.hide();
                        $end.show();
                    } else {
                        $btn.prop('disabled', false).text(originalLabel);
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).text(originalLabel);
                }
            });
            return false;
        });
    })(jQuery)
</script>
{% endif %}
{% endblock %}
